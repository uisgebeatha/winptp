<Window x:Class="WinPTP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinPTP"
        mc:Ignorable="d"
        Title="WinPTP Text Label"
        Height="570"
        Width="720"
        MinHeight="530"
        MinWidth="600"
        Loaded="MainWindow_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="18"
                   FontWeight="SemiBold"
                   Text="PT-P300BT text label" />

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Text="Label text:" />
            <TextBox x:Name="LabelTextBox"
                     Grid.Column="1"
                     Padding="6,4"
                     Text="WinPTP Test" />
            <TextBlock x:Name="LabelLengthTextBlock"
                       Grid.Column="2"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Text="Label length: 0.0 mm" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Text="Font:" />
            <ComboBox x:Name="FontComboBox"
                      Grid.Column="1"
                      MinWidth="180"
                      Margin="0,0,16,0"
                      SelectionChanged="FontComboBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"
                                   FontFamily="{Binding FontFamily}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="2"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Text="Size:" />
            <ComboBox x:Name="SizeModeComboBox"
                      Grid.Column="3"
                      Width="80"
                      Margin="0,0,10,0"
                      SelectionChanged="SizeModeComboBox_SelectionChanged" />
            <TextBlock Grid.Column="4"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Text="Dots:" />
            <Slider x:Name="FontSizeSlider"
                    Grid.Column="5"
                    Minimum="1"
                    Maximum="60"
                    TickFrequency="0.5"
                    IsSnapToTickEnabled="True"
                    Value="24"
                    ValueChanged="FontSizeSlider_ValueChanged" />
            <TextBlock x:Name="FontSizeValueTextBlock"
                       Grid.Column="6"
                       Width="54"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Text="—" />
        </Grid>

        <GroupBox Grid.Row="3"
                  Height="210"
                  Margin="0,12,0,16"
                  Header="Raster preview (12 mm tape)">
            <Grid Margin="8" Background="#FFE4E4E4">
                <Image x:Name="PreviewImage"
                       Margin="12"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       SnapsToDevicePixels="True"
                       Stretch="Uniform" />
                <TextBlock x:Name="PreviewPlaceholderTextBlock"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#FF666666"
                           Text="Generating preview..." />
            </Grid>
        </GroupBox>

        <Grid Grid.Row="4" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Text="COM port:" />
            <ComboBox x:Name="PortComboBox"
                      Grid.Column="1"
                      MinWidth="130"
                      Margin="0,0,8,0"
                      VerticalContentAlignment="Center" />
            <Button x:Name="RefreshButton"
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    Padding="12,5"
                    Click="RefreshButton_Click"
                    Content="Refresh" />
            <Button x:Name="CheckPrinterButton"
                    Grid.Column="3"
                    Margin="0,0,8,0"
                    Padding="12,5"
                    Click="CheckPrinterButton_Click"
                    Content="Check Printer" />
            <Button x:Name="PrintButton"
                    Grid.Column="4"
                    Padding="12,5"
                    Click="PrintButton_Click"
                    Content="Print"
                    IsEnabled="False" />
        </Grid>

        <Border Grid.Row="5"
                Padding="12"
                BorderBrush="#FFC8C8C8"
                BorderThickness="1"
                CornerRadius="3">
            <TextBlock x:Name="StatusTextBlock"
                       Text="Select a COM port, then check the printer."
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
